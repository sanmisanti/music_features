\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces Análisis de diversidad semántica de embeddings BERT: (a) distribución de distancias coseno entre embeddings mostrando patrón gaussiano centrado en 0.7-0.8 con media de 0.73, validando alta heterogeneidad temática, (b) Q-Q plot confirmando distribución aproximadamente normal con cola extendida hacia similaridades altas (0.9+) correspondientes a canciones temáticamente relacionadas.}}{18}{figure.1.4}\protected@file@percent }
\newlabel{fig:distancias_coseno_bert}{{1.4}{18}{Análisis de diversidad semántica de embeddings BERT: (a) distribución de distancias coseno entre embeddings mostrando patrón gaussiano centrado en 0.7-0.8 con media de 0.73, validando alta heterogeneidad temática, (b) Q-Q plot confirmando distribución aproximadamente normal con cola extendida hacia similaridades altas (0.9+) correspondientes a canciones temáticamente relacionadas}{figure.1.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.5}{\ignorespaces Análisis de utilización del espacio vectorial 384D: (a) varianza explicada por componente principal mostrando distribución uniforme sin dominancia específica, (b) varianza acumulada evidenciando utilización efectiva del espacio completo, (c) distribución de normas L2 de embeddings con normalización consistente, (d) correlaciones entre dimensiones confirmando independencia estructural y ausencia de redundancia excesiva.}}{18}{figure.1.5}\protected@file@percent }
\newlabel{fig:analisis_dimensional_bert}{{1.5}{18}{Análisis de utilización del espacio vectorial 384D: (a) varianza explicada por componente principal mostrando distribución uniforme sin dominancia específica, (b) varianza acumulada evidenciando utilización efectiva del espacio completo, (c) distribución de normas L2 de embeddings con normalización consistente, (d) correlaciones entre dimensiones confirmando independencia estructural y ausencia de redundancia excesiva}{figure.1.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.6}{\ignorespaces Validación de clustering readiness semántico: (a) proyección t-SNE revelando estructura natural de agrupaciones temáticas en embeddings BERT, (b) proyección PCA mostrando separabilidad en componentes de máxima varianza, (c) Hopkins Statistic de 0.71 clasificado como "BUENO" para clustering, (d) análisis de separabilidad intra/inter-cluster con ratio 0.89 confirmando diferenciación clara entre grupos semánticos.}}{19}{figure.1.6}\protected@file@percent }
\newlabel{fig:clustering_readiness_bert}{{1.6}{19}{Validación de clustering readiness semántico: (a) proyección t-SNE revelando estructura natural de agrupaciones temáticas en embeddings BERT, (b) proyección PCA mostrando separabilidad en componentes de máxima varianza, (c) Hopkins Statistic de 0.71 clasificado como "BUENO" para clustering, (d) análisis de separabilidad intra/inter-cluster con ratio 0.89 confirmando diferenciación clara entre grupos semánticos}{figure.1.6}{}}
